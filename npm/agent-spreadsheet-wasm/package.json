{
  "name": "agent-spreadsheet-wasm",
  "version": "0.16.0",
  "description": "WebAssembly byte/session runtime for agent-spreadsheet — create a session from workbook bytes, dispatch canonical operations, export bytes",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PSU3D0/agent-spreadsheet.git",
    "directory": "npm/agent-spreadsheet-wasm"
  },
  "homepage": "https://github.com/PSU3D0/agent-spreadsheet",
  "bugs": {
    "url": "https://github.com/PSU3D0/agent-spreadsheet/issues"
  },
  "keywords": [
    "spreadsheet",
    "xlsx",
    "wasm",
    "webassembly",
    "agent"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./bindings": "./pkg/agent_spreadsheet_wasm.js",
    "./agent_spreadsheet_wasm_bg.wasm": "./pkg/agent_spreadsheet_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "pkg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
